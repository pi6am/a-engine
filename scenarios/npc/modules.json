{
  "name": "npc-modules",
  "modules": [
    {
      "id": "room",
      "name": "Room",
      "fields": [],
      "affordances": []
    },
    {
      "id": "agent",
      "name": "Agent",
      "fields": [
        { "name": "policy", "type": "string", "default": "player" },
        { "name": "character", "type": "string", "default": "" },
        { "name": "goals", "type": "string", "default": "" },
        { "name": "traits", "type": "string", "default": "" },
        { "name": "memoryLength", "type": "int", "default": 25 },
        { "name": "posture", "type": "string", "default": "standing" }
      ],
      "affordances": [
        { "verb": "look", "handler": "look", "repeatBackoff": true },
        { "verb": "inventory", "handler": "inventory" },
        { "verb": "wait", "handler": "wait", "repeatBackoff": true }
      ]
    },
    {
      "id": "can_speak",
      "name": "Can speak",
      "fields": [],
      "affordances": [
        {
          "verb": "say",
          "handler": "say",
          "prompt": "Say what?",
          "signals": [
            { "sense": "audible", "priority": 10, "text": "{agent} says: \"{arg}\"" },
            { "sense": "visual", "priority": 1, "text": "{agent}'s lips move." }
          ]
        }
      ]
    },
    {
      "id": "portal",
      "name": "Portal (door side)",
      "fields": [
        { "name": "stateRef", "type": "ref", "default": null },
        { "name": "direction", "type": "string", "default": "" },
        { "name": "to", "type": "ref", "default": null },
        { "name": "lockedBy", "type": "ref", "default": null },
        { "name": "transmitVisual", "type": "string", "default": "whenOpen" },
        { "name": "transmitAudio", "type": "string", "default": "always" }
      ],
      "affordances": [
        {
          "verb": "go",
          "handler": "go",
          "duration": 3,
          "postures": ["standing"],
          "signals": [
            { "sense": "visual", "priority": 10, "scope": "departure", "text": "{agent} exits through the {exitPortal} to the {exitDirection}." },
            { "sense": "audible", "priority": 5, "scope": "departure", "text": "{agent} leaving through the {exitPortal}." },
            { "sense": "visual", "priority": 10, "scope": "arrival", "text": "{agent} enters from the {entryPortal} to the {entryDirection}." },
            { "sense": "audible", "priority": 5, "scope": "arrival", "text": "footsteps approaching from the {entryPortal}." }
          ]
        },
        {
          "verb": "open",
          "handler": "open",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 10, "text": "{agent} opens the {target}." },
            { "sense": "audible", "priority": 5, "text": "the sound of wood sliding on wood." }
          ]
        },
        {
          "verb": "close",
          "handler": "close",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 10, "text": "{agent} closes the {target}." },
            { "sense": "audible", "priority": 5, "text": "a door thudding shut." }
          ]
        }
      ]
    },
    {
      "id": "doorstate",
      "name": "Shared door state",
      "fields": [
        { "name": "open", "type": "bool", "default": false },
        { "name": "locked", "type": "bool", "default": false }
      ],
      "affordances": []
    },
    {
      "id": "openable",
      "name": "Openable",
      "fields": [
        { "name": "open", "type": "bool", "default": false }
      ],
      "affordances": [
        {
          "verb": "open",
          "handler": "open",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 10, "text": "{agent} opens the {target}." },
            { "sense": "audible", "priority": 5, "text": "something creaking open." }
          ]
        },
        {
          "verb": "close",
          "handler": "close",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 10, "text": "{agent} closes the {target}." },
            { "sense": "audible", "priority": 5, "text": "something thudding shut." }
          ]
        }
      ]
    },
    {
      "id": "container",
      "name": "Container",
      "fields": [
        { "name": "capacity", "type": "int", "default": 10 }
      ],
      "affordances": [
        {
          "verb": "put",
          "handler": "put",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} puts the {item} into the {target}." }
          ]
        }
      ]
    },
    {
      "id": "portable",
      "name": "Portable",
      "fields": [],
      "affordances": [
        {
          "verb": "take",
          "handler": "take",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} picks up the {target}{container}." }
          ]
        },
        {
          "verb": "drop",
          "handler": "drop",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} drops the {target}." },
            { "sense": "audible", "priority": 3, "text": "something hitting the floor." }
          ]
        },
        {
          "verb": "give",
          "handler": "give",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} gives the {item} to the {target}." }
          ],
          "failSignals": [
            { "sense": "visual", "priority": 5, "text": "{target} declines the {item}." }
          ],
          "reaction": {
            "window": 3,
            "telegraph": "{agent} offers the {item} to the {target}.",
            "actorText": "You offer the {item} to {target}.",
            "options": [
              { "id": "accept", "label": "Accept", "noResist": true, "default": true, "text": "You accept the gift." },
              { "id": "decline", "label": "Decline", "text": "You decline the gift." }
            ]
          }
        }
      ]
    },
    {
      "id": "body",
      "name": "Body",
      "fields": [
        { "name": "regions", "type": "list", "default": ["head", "top", "bottom", "feet"] }
      ],
      "affordances": []
    },
    {
      "id": "wearable",
      "name": "Wearable",
      "fields": [
        { "name": "regions", "type": "list", "default": [] },
        { "name": "worn", "type": "bool", "default": false }
      ],
      "affordances": [
        {
          "verb": "wear",
          "handler": "wear",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} puts on the {target}." },
            { "sense": "audible", "priority": 3, "text": "the rustling of clothing being put on." }
          ]
        },
        {
          "verb": "remove",
          "handler": "remove",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} takes off the {target}." },
            { "sense": "audible", "priority": 3, "text": "the rustling of clothing being removed." }
          ]
        }
      ]
    },
    {
      "id": "sittable",
      "name": "Sittable",
      "fields": [
        { "name": "capacity", "type": "int", "default": 1 }
      ],
      "affordances": [
        {
          "verb": "sit",
          "handler": "sit",
          "duration": 2,
          "postures": ["standing"],
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} sits down on the {target}." }
          ]
        },
        {
          "verb": "stand",
          "handler": "stand",
          "duration": 2,
          "postures": ["sitting"],
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} gets up from the {target}." }
          ]
        }
      ]
    },
    {
      "id": "lyable",
      "name": "Lyable",
      "fields": [
        { "name": "capacity", "type": "int", "default": 1 }
      ],
      "affordances": [
        {
          "verb": "lie",
          "handler": "lie",
          "duration": 2,
          "postures": ["standing"],
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} lies down on the {target}." }
          ]
        },
        {
          "verb": "stand",
          "handler": "stand",
          "duration": 2,
          "postures": ["lying"],
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} gets up from the {target}." }
          ]
        }
      ]
    },
    {
      "id": "lockable",
      "name": "Lockable",
      "fields": [
        { "name": "keyRef", "type": "ref", "default": null }
      ],
      "affordances": [
        {
          "verb": "unlock",
          "handler": "unlock",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 3, "text": "{agent} unlocks the {target}." },
            { "sense": "audible", "priority": 5, "text": "a click." }
          ]
        },
        {
          "verb": "lock",
          "handler": "lock",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 3, "text": "{agent} locks the {target}." },
            { "sense": "audible", "priority": 5, "text": "a click." }
          ]
        }
      ]
    }
  ]
}
