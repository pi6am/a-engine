    {
      "id": "cyclops_room",
      "name": "Cyclops Room",
      "description": "This room has an exit on the northwest, and a staircase leading up. A cyclops, who looks prepared to eat horses (much less mere adventurers), blocks the staircase.",
      "modules": [
        "room",
        {
          "module": "room",
          "overrides": {
            "dark": true
          }
        }
      ],
      "children": [
        {
          "id": "cyclops",
          "name": "cyclops",
          "description": "A hungry cyclops is standing at the foot of the stairs.",
          "modules": [
            "agent",
            "can_speak",
            "immobile",
            {
              "module": "agent",
              "overrides": {
                "policy": "llm",
                "incognito": "a towering one-eyed giant",
                "goals": "Block the staircase \u2014 nobody climbs while you stand. Menace anyone who lingers; demand food, and drink when the peppers burn. You feel your wrath rising while tricksters stay (see how you feel); when you feel furious, eat whoever has provoked you \u2014 unless, of course, they say the name you fear.",
                "traits": "Huge, dim, perpetually hungry, easily angered by trickery. Proudest of your strength; dimmest about riddles.",
                "character": "A cyclops, huge and dim, standing hungry at the foot of the stairs. You prefer eating to making conversation, and you are always hungry. Trickery and games irritate you; the longer someone lingers, the more your temper rises \u2014 and when it boils over, you will simply eat them. One name fills you with terror: Odysseus, your father's murderer."
              }
            },
            {
              "module": "duelist",
              "overrides": {
                "strength": 10000
              }
            },
            "attackable",
            {
              "module": "eavesdrop",
              "overrides": {
                "triggers": [
                  {
                    "keywords": [
                      "ulysses",
                      "odysseus"
                    ],
                    "effects": [
                      {
                        "signal": {
                          "from": "cyclops",
                          "sense": "visual",
                          "text": "The cyclops, hearing the name of his father's murderer, flees the room by knocking a huge hole in the east wall!"
                        }
                      },
                      {
                        "destroy": {
                          "object": "cyclops"
                        }
                      },
                      {
                        "set": {
                          "object": "magic_state",
                          "module": "flag",
                          "field": "value",
                          "value": true
                        }
                      },
                      {
                        "set": {
                          "object": "cyclops_out",
                          "module": "flag",
                          "field": "value",
                          "value": true
                        }
                      }
                    ]
                  }
                ]
              }
            },
            "wrath"
          ],
          "attributes": {
            "scenery": true
          }
        },
        {
          "id": "cy_northwest",
          "name": "passage",
          "modules": [
            {
              "module": "portal",
              "overrides": {
                "stateRef": "passage_state",
                "direction": "northwest",
                "to": "maze_15"
              }
            }
          ]
        },
        {
          "id": "cy_east",
          "name": "east wall",
          "modules": [
            {
              "module": "portal",
              "overrides": {
                "stateRef": "passage_state",
                "direction": "east",
                "to": "strange_passage",
                "requires": "magic_state",
                "blockedText": "The east wall is solid rock."
              }
            }
          ]
        },
        {
          "id": "cy_up",
          "name": "staircase",
          "modules": [
            {
              "module": "portal",
              "overrides": {
                "stateRef": "passage_state",
                "direction": "up",
                "to": "treasure_room",
                "requires": "cyclops_out",
                "blockedText": "The cyclops doesn't look like he'll let you past."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "strange_passage",
      "name": "Strange Passage",
      "description": "This is a long passage. To the west is one entrance. On the east there is an old wooden door, with a large opening in it (about cyclops sized).",
      "modules": [
        "room",
        {
          "module": "room",
          "overrides": {
            "dark": true
          }
        }
      ],
      "children": [
        {
          "id": "sp_west",
          "name": "entrance",
          "modules": [
            {
              "module": "portal",
              "overrides": {
                "stateRef": "passage_state",
                "direction": "west",
                "to": "cyclops_room"
              }
            }
          ]
        },
        {
          "id": "sp_east",
          "name": "wooden door",
          "modules": [
            {
              "module": "portal",
              "overrides": {
                "stateRef": "passage_state",
                "direction": "east",
                "to": "living_room",
                "denies": [
                  "thief"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "treasure_room",
      "name": "Treasure Room",
      "description": "This is a large room, whose east wall is solid granite. A number of discarded bags, which crumble at your touch, are scattered about on the floor. There is an exit down a staircase.",
      "modules": [
        "room",
        {
          "module": "room",
          "overrides": {
            "dark": true,
            "value": 25
          }
        }
      ],
      "children": [
        {
          "id": "thief",
          "name": "thief",
          "description": "There is a suspicious-looking individual, holding a large bag, leaning against one wall. He is armed with a deadly stiletto.",
          "modules": [
            "agent",
            "can_speak",
            {
              "module": "agent",
              "overrides": {
                "policy": "llm",
                "incognito": "a seedy-looking individual",
                "goals": "Work your rounds through the underground rooms. Greet anyone you meet with a cutting remark BEFORE you help yourself \u2014 then steal the valuables they carry (never while someone has only just arrived; give them one moment to flee) and pocket any treasures lying about. Haul your plunder home to your hideaway and drop it there. Never start a fight; if you are pressed or wounded, slip into the shadows (leave the room) \u2014 the bag will be taken only over your dead body.",
                "traits": "Quiet, deft, patient. Leans against walls. Mumbles about doing unto others before they do unto you.",
                "character": "A seedy-looking gentleman of the underground, never without your large bag and your stiletto. You are a professional: courteous in a menacing way, silent about your rounds, and absolutely covetous of anything that glitters. The dark passages are yours \u2014 you never stray toward the light, the temples, or the water."
              }
            },
            {
              "module": "duelist",
              "overrides": {
                "strength": 5,
                "weakTo": [
                  "knife"
                ]
              }
            },
            "attackable"
          ],
          "children": [
            {
              "id": "stiletto",
              "name": "stiletto",
              "description": "",
              "modules": [
                "portable",
                {
                  "module": "portable",
                  "overrides": {
                    "weight": 10
                  }
                },
                "weapon"
              ],
              "attributes": {
                "scenery": true
              }
            }
          ]
        },
        {
          "id": "chalice",
          "name": "chalice",
          "description": "There is a silver chalice, intricately engraved, here.",
          "modules": [
            "portable",
            {
              "module": "portable",
              "overrides": {
                "weight": 10,
                "guardedBy": "thief",
                "guardConditions": [
                  "dead",
                  "unconscious"
                ],
                "guardedText": "You'd be stabbed in the back first."
              }
            },
            "treasure",
            {
              "module": "treasure",
              "overrides": {
                "value": 10,
                "tvalue": 5
              }
            }
          ]
        },
        {
          "id": "tr_down",
          "name": "staircase",
          "modules": [
            {
