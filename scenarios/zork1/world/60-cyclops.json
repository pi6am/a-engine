          }
        }
      ]
    },
    {
      "id": "thief_defends_arrivals",
      "name": "the treasure room's guardian stirs",
      "modules": [
        "automation",
        {
          "module": "automation",
          "overrides": {
            "once": true,
            "when": [
              {
                "of": "player",
                "inRoom": "treasure_room"
              },
              {
                "of": "thief",
                "hasCondition": "dead",
                "negate": true
              }
            ],
            "effects": [
              {
                "signal": {
                  "from": "thief",
                  "sense": "visual",
                  "text": "A scream of anguish echoes from somewhere nearby: the thief has noticed your intrusion into his hideaway, and rushes to defend it!"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "cond_grumpy",
      "name": "grumpy",
      "modules": [
        {
          "module": "condition",
          "overrides": {
            "kind": "grumpy",
            "label": "grumpy",
            "visible": true,
            "selfText": "The tricks of these little people begin to grate.",
            "traits": "Irritated, stomach rumbling louder."
          }
        }
      ]
    },
    {
      "id": "cond_furious",
      "name": "furious",
      "modules": [
        {
          "module": "condition",
          "overrides": {
            "kind": "furious",
            "label": "furious",
            "visible": true,
            "selfText": "Your temper boils. One more trick and you will dine on trickster.",
            "traits": "Furious; barely holding back from eating someone."
          }
        }
      ]
    },
    {
      "id": "cyclops_grows_wroth",
      "name": "the cyclops' temper rises while tricksters linger",
      "modules": [
        "automation",
        {
          "module": "automation",
          "overrides": {
            "every": 1,
            "when": [
              {
                "of": "player",
                "inRoom": "cyclops_room"
              },
              {
                "of": "cyclops_out",
                "module": "flag",
                "field": "value",
                "equals": false
              },
              {
                "of": "cyclops",
                "hasCondition": "unconscious",
                "negate": true
              }
            ],
            "effects": [
              {
                "adjust": {
                  "of": "cyclops",
                  "module": "wrath",
                  "field": "level",
                  "by": 1
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "cyclops_cools",
      "name": "the cyclops' temper cools when nobody lingers",
      "modules": [
        "automation",
        {
          "module": "automation",
          "overrides": {
            "every": 1,
            "when": [
              {
                "of": "cyclops",
                "module": "wrath",
                "field": "level",
                "min": 1
              },
              {
                "of": "player",
                "inRoom": "cyclops_room",
                "negate": true
              }
            ],
            "effects": [
