                  "to": "cyclops"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "cyclops_wrath_boils_over",
      "name": "the cyclops, tired of games, dines",
      "modules": [
        "automation",
        {
          "module": "automation",
          "overrides": {
            "once": true,
            "when": [
              {
                "of": "cyclops",
                "module": "wrath",
                "field": "level",
                "min": 6
              },
              {
                "of": "player",
                "inRoom": "cyclops_room"
              }
            ],
            "effects": [
              {
                "signal": {
                  "from": "cyclops",
                  "sense": "visual",
                  "text": "The cyclops, tired of all of your games and trickery, grabs you firmly. As he licks his chops, he says \"Mmm. Just like Mom used to make 'em.\" It's nice to be appreciated."
                }
              },
              {
                "attach": {
                  "condition": "cond_dead",
                  "to": "player"
                }
              }
            ]
          }
