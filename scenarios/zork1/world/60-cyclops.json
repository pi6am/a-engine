                    "inRoom": "forest_1"
                  }
                ]
              },
              {
                "move": {
                  "object": "bauble",
                  "to": "actorRoom"
                },
                "when": [
                  {
                    "of": "player",
                    "inRoom": "forest_2"
                  }
                ]
              },
              {
                "move": {
                  "object": "bauble",
                  "to": "actorRoom"
                },
                "when": [
                  {
                    "of": "player",
                    "inRoom": "forest_3"
                  }
                ]
              },
              {
                "move": {
                  "object": "bauble",
                  "to": "actorRoom"
                },
                "when": [
                  {
                    "of": "player",
                    "inRoom": "path"
                  }
                ]
              },
              {
                "move": {
                  "object": "bauble",
                  "to": "actorRoom"
                },
                "when": [
                  {
                    "of": "player",
                    "inRoom": "up_a_tree"
                  }
                ]
              },
              {
                "set": {
                  "object": "canary",
                  "module": "windable",
                  "field": "done",
                  "value": true
                }
              }
            ]
          }
        }
      ],
      "firstDescription": "There is a golden clockwork canary nestled in the egg. It has ruby eyes and a silver beak. Through a crystal window below its left wing you can see intricate machinery inside. It appears to have wound down."
    },
    {
      "id": "cyclops_eats_the_lunch",
      "name": "the cyclops wolfs down the lunch",
      "modules": [
        "automation",
        {
          "module": "automation",
          "overrides": {
            "once": true,
            "when": [
              {
                "holder": "cyclops",
                "holds": "lunch"
              }
            ],
            "effects": [
              {
                "destroy": {
                  "object": "lunch"
                }
              },
              {
                "set": {
                  "object": "cyclops_hungry",
                  "module": "flag",
                  "field": "value",
                  "value": true
                }
              },
              {
                "signal": {
                  "from": "cyclops",
                  "sense": "visual",
                  "text": "The cyclops wolfs down the sandwich. He seems to be suffering from heartburn, and clutching his throat, he asks for something to drink."
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "cyclops_drinks_and_sleeps",
      "name": "the hot-peppered cyclops drinks and collapses",
      "modules": [
        "automation",
        {
          "module": "automation",
          "overrides": {
            "once": true,
            "when": [
              {
                "holder": "cyclops",
                "holds": "bottle"
              },
              {
                "of": "cyclops_hungry",
                "module": "flag",
                "field": "value",
                "equals": true
              }
            ],
            "effects": [
              {
                "destroy": {
                  "object": "water"
                }
              },
              {
                "attach": {
                  "condition": "cond_unconscious",
                  "to": "cyclops"
                }
              },
              {
                "set": {
                  "object": "cyclops",
                  "module": "duelist",
                  "field": "out",
                  "value": true
                }
              },
              {
                "set": {
                  "object": "cyclops_out",
                  "module": "flag",
                  "field": "value",
                  "value": true
                }
              },
              {
                "signal": {
                  "from": "cyclops",
                  "sense": "visual",
                  "text": "The cyclops grabs the bottle, drinks deeply, and falls into a deep slumber."
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "thief_opens_the_egg",
      "name": "the thief, given the egg, opens it with care",
      "modules": [
