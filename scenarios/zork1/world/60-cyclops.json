        {
          "module": "automation",
          "overrides": {
            "once": true,
            "when": [
              {
                "holder": "thief",
                "holds": "egg"
              }
            ],
            "effects": [
              {
                "addModule": {
                  "object": "egg",
                  "module": "container"
                }
              },
              {
                "addModule": {
                  "object": "egg",
                  "module": "openable"
                }
              },
              {
                "set": {
                  "object": "egg",
                  "module": "openable",
                  "field": "open",
                  "value": true
                }
