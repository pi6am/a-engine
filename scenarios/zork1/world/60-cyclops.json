                "adjust": {
                  "of": "cyclops",
                  "module": "wrath",
                  "field": "level",
                  "by": -1
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "cyclops_seethes",
      "name": "the cyclops seethes",
      "modules": [
        "automation",
        {
          "module": "automation",
          "overrides": {
            "once": true,
            "when": [
              {
                "of": "cyclops",
