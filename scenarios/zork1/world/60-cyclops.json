                "attach": {
                  "condition": "cond_grumpy",
                  "to": "cyclops"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "cyclops_rages",
      "name": "the cyclops rages",
      "modules": [
        "automation",
        {
          "module": "automation",
          "overrides": {
            "once": true,
            "when": [
              {
                "of": "cyclops",
                "module": "wrath",
                "field": "level",
                "min": 4
