          "id": "skeleton",
          "name": "skeleton",
          "description": "",
          "modules": [
            "shiftable",
            {
              "module": "shiftable",
              "overrides": {
                "once": true,
                "onMove": [
                  {
                    "signal": {
                      "from": "skeleton",
                      "sense": "visual",
                      "text": "A ghost appears in the room and is appalled at the way you've been treating its remains. It casts a curse on your valuables and departs, moaning and groaning."
                    }
                  },
                  {
                    "scatter": {
                      "from": "player",
                      "filterModule": "treasure",
                      "to": [
                        "land_of_living_dead"
                      ]
                    }
                  },
                  {
                    "set": {
                      "of": "skeleton",
                      "module": "shiftable",
                      "field": "moved",
                      "value": true
                    }
                  }
                ]
              }
            }
          ]
        },
