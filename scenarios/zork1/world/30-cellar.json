{
  "world": [
    {
      "id": "trapdoor_state",
      "name": "trap door state",
      "modules": [
        {
          "module": "doorstate",
          "overrides": {
            "open": false,
            "locked": false,
            "openText": "The door reluctantly opens to reveal a rickety staircase descending into darkness.",
            "closeText": "The door swings shut and closes."
          }
        }
      ]
    },
    {
      "id": "trapdoor_armed",
      "name": "trap door slam armed",
      "description": "Whether the cellar's slam still lurks (cleared once it fires; re-armed by a chimney climb over a closed door).",
