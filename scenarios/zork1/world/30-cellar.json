    {
      "id": "cellar",
      "name": "Cellar",
      "description": "You are in a dark and damp cellar with a narrow passageway leading north, and a crawlway to the south. On the west is the bottom of a steep metal ramp which is unclimbable.",
      "modules": [
        "room",
        {
          "module": "room",
          "overrides": {
            "dark": true,
            "value": 25
          }
        }
      ],
      "children": [
        {
          "id": "cellar_up",
          "name": "trap door",
          "description": "A heavy wooden trap door above you.",
          "modules": [
            {
              "module": "portal",
              "overrides": {
                "stateRef": "trapdoor_state",
                "direction": "up",
                "to": "living_room",
                "barred": true,
                "barredText": "The door is locked from above.",
                "denies": [
                  "thief"
                ]
              }
            },
            "door"
          ]
        },
        {
          "id": "cellar_north",
          "name": "narrow passageway",
          "modules": [
            {
              "module": "portal",
              "overrides": {
                "stateRef": "passage_state",
                "direction": "north",
                "to": "troll_room"
              }
            }
          ]
        },
        {
          "id": "cellar_south",
          "name": "crawlway",
          "modules": [
            {
              "module": "portal",
              "overrides": {
                "stateRef": "passage_state",
                "direction": "south",
                "to": "east_of_chasm"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "troll_room",
      "name": "The Troll Room",
      "description": "This is a small room with passages to the east and south and a forbidding hole leading west. Bloodstains and deep scratches (perhaps made by an axe) mar the walls.",
      "modules": [
        "room",
        {
          "module": "room",
          "overrides": {
            "dark": true
          }
        }
      ],
      "children": [
        {
          "id": "troll",
          "name": "troll",
          "description": "A nasty-looking troll, brandishing a bloody axe, blocks all passages out of the room.",
          "modules": [
            "agent",
            "can_speak",
            "immobile",
            {
              "module": "agent",
              "overrides": {
                "policy": "llm",
                "incognito": "a hulking, nasty-looking troll",
                "goals": "Guard this room: no one passes east or west while you stand. Keep hold of your bloody axe \u2014 the moment you see it on the floor, snatch it up and resume your stance. If you are disarmed and a armed adventurer presses you, cower and plead for your life in the guttural tongue of the trolls until the axe is back in your hand. Attack anyone who attacks you.",
                "traits": "Nameless, refers to self as 'Me'. Dumb, brutal, territorial. Blocks passages with menacing gestures; laughs at puny gestures.",
                "character": "A nasty-looking troll who guards the passage under the cellar. You are dim, brutal, and proud of your post; the axe is your argument and your prize. You are not much of a conversationalist, and you never steal items \u2014 taking a thing that isn't swinging at you is beneath a troll."
              }
            },
            {
              "module": "duelist",
              "overrides": {
                "strength": 2,
                "weakTo": [
                  "sword"
                ]
              }
            },
            "attackable"
          ],
          "children": [
            {
              "id": "axe",
              "name": "bloody axe",
              "description": "",
              "modules": [
                "portable",
                {
                  "module": "portable",
                  "overrides": {
                    "weight": 25
                  }
                },
                "weapon"
              ],
              "attributes": {
                "scenery": true
              }
            }
          ]
        },
        {
          "id": "troll_south",
          "name": "passageway",
          "modules": [
            {
              "module": "portal",
              "overrides": {
                "stateRef": "passage_state",
                "direction": "south",
                "to": "cellar"
              }
            }
          ]
        },
        {
          "id": "troll_east",
          "name": "passage",
          "modules": [
            {
              "module": "portal",
              "overrides": {
                "stateRef": "passage_state",
                "direction": "east",
                "to": "ew_passage",
                "requires": "troll_state",
                "blockedText": "The troll fends you off with a menacing gesture."
              }
            }
          ]
        },
        {
          "id": "troll_west",
          "name": "forbidding hole",
          "modules": [
            {
              "module": "portal",
              "overrides": {
                "stateRef": "passage_state",
                "direction": "west",
                "to": "maze_1",
                "requires": "troll_state",
                "blockedText": "The troll fends you off with a menacing gesture."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "east_of_chasm",
      "name": "East of Chasm",
      "description": "You are on the east edge of a chasm, the bottom of which cannot be seen. A narrow passage goes north, and the path you are on continues to the east.",
      "modules": [
        "room",
        {
          "module": "room",
          "overrides": {
            "dark": true
          }
        }
      ],
      "children": [
        {
          "id": "chasm_north",
