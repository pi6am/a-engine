          "modules": [
            {
              "module": "portal",
              "overrides": {
                "stateRef": "passage_state",
                "direction": "north",
                "to": "cellar"
              }
            }
          ]
        },
        {
          "id": "chasm_east",
          "name": "path",
          "modules": [
            {
              "module": "portal",
              "overrides": {
                "stateRef": "passage_state",
                "direction": "east",
                "to": "gallery"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "gallery",
      "name": "Gallery",
      "description": "This is an art gallery. Most of the paintings have been stolen by vandals with exceptional taste. The vandals left through either the north or west exits.",
      "modules": [
        "room"
      ],
      "children": [
        {
          "id": "painting",
          "name": "painting",
          "description": "A painting by a neglected genius is here.",
          "modules": [
            "portable",
            {
              "module": "portable",
              "overrides": {
                "weight": 15
              }
            },
            "treasure",
            {
              "module": "treasure",
              "overrides": {
                "value": 4,
                "tvalue": 6
              }
            }
          ],
          "firstDescription": "Fortunately, there is still one chance for you to be a vandal, for on the far wall is a painting of unparalleled beauty."
        },
        {
          "id": "gallery_west",
          "name": "exit",
          "modules": [
            {
              "module": "portal",
              "overrides": {
                "stateRef": "passage_state",
                "direction": "west",
                "to": "east_of_chasm"
              }
            }
          ]
        },
        {
          "id": "gallery_north",
          "name": "exit",
          "modules": [
            {
              "module": "portal",
              "overrides": {
                "stateRef": "passage_state",
                "direction": "north",
                "to": "studio"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "studio",
      "name": "Studio",
      "description": "This appears to have been an artist's studio. The walls and floors are splattered with paints of 69 different colors. Strangely enough, nothing of value is hanging here. At the south end of the room is an open door (also covered with paint). A dark and narrow chimney leads up from a fireplace; although you might be able to get up it, it seems unlikely you could get back down.",
      "modules": [
        "room",
        {
          "module": "room",
          "overrides": {
            "dark": true
          }
        }
      ],
      "children": [
        {
          "id": "chimney_up",
          "name": "chimney",
          "description": "A dark and narrow chimney, just wide enough to climb with empty hands.",
          "modules": [
            {
              "module": "portal",
              "overrides": {
                "stateRef": "passage_state",
                "direction": "up",
                "to": "kitchen",
                "requiresCarrying": [
                  "lamp"
                ],
                "allowOnly": [
                  "lamp"
                ],
                "allowPlus": 1,
                "blockedText": "You can't get up the chimney with what you're carrying.",
                "onExit": [
                  {
                    "when": [
                      {
                        "of": "trapdoor_state",
                        "module": "doorstate",
                        "field": "open",
                        "equals": false
                      }
                    ],
                    "set": {
                      "object": "trapdoor_armed",
                      "module": "flag",
                      "field": "value",
                      "value": true
                    }
                  }
                ],
                "denies": [
                  "thief"
                ]
              }
            }
          ]
        },
        {
          "id": "studio_south",
          "name": "open door",
          "modules": [
            {
              "module": "portal",
              "overrides": {
                "stateRef": "passage_state",
                "direction": "south",
                "to": "gallery"
              }
            }
          ]
        }
      ]
    },
