        {
          "id": "bell",
          "name": "brass bell",
          "description": "",
          "modules": [
            "portable",
            "ringable",
            {
              "module": "portable",
              "overrides": {
                "weight": 10
              }
            },
            {
              "module": "ringable",
              "overrides": {
                "onRing": [
                  {
                    "set": {
                      "object": "hades_stage",
                      "module": "flag",
                      "field": "count",
                      "value": 1
                    },
                    "when": [
                      {
                        "of": "player",
                        "inRoom": "entrance_to_hades"
                      }
                    ]
                  },
                  {
                    "move": {
                      "object": "bell",
                      "to": "entrance_to_hades"
                    },
                    "when": [
                      {
                        "of": "player",
                        "inRoom": "entrance_to_hades"
                      }
                    ]
                  },
                  {
                    "rename": {
                      "object": "bell",
                      "name": "red-hot bell",
                      "description": "A large brass bell, far too hot to hold."
                    },
                    "when": [
                      {
                        "of": "player",
                        "inRoom": "entrance_to_hades"
                      }
                    ]
                  },
                  {
                    "say": {
                      "to": "player",
                      "text": "The bell suddenly becomes red hot and falls to the ground. The wraiths, as if paralyzed, stop their jeering and slowly turn to face you. On their ashen faces, the expression of a long-forgotten terror takes shape."
                    },
                    "when": [
                      {
                        "of": "player",
                        "inRoom": "entrance_to_hades"
                      }
                    ]
                  },
                  {
                    "set": {
                      "object": "candles",
                      "module": "lightsource",
                      "field": "on",
                      "value": false
                    },
                    "when": [
                      {
                        "holder": "player",
                        "holds": "candles"
                      },
                      {
                        "of": "player",
                        "inRoom": "entrance_to_hades"
                      }
                    ]
                  },
                  {
                    "move": {
                      "object": "candles",
                      "to": "entrance_to_hades"
                    },
                    "when": [
                      {
                        "holder": "player",
                        "holds": "candles"
                      },
                      {
                        "of": "player",
                        "inRoom": "entrance_to_hades"
                      }
                    ]
                  },
                  {
                    "say": {
                      "to": "player",
                      "text": "In your confusion, the candles drop to the ground (and they are out)."
                    },
                    "when": [
                      {
                        "of": "player",
                        "inRoom": "entrance_to_hades"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
