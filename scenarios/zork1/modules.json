{
  "name": "zork1-modules",
  "modules": [
    {
      "id": "room",
      "name": "Room",
      "fields": [
        { "name": "dark", "type": "bool", "default": false },
        { "name": "value", "type": "int", "default": 0 },
        { "name": "visited", "type": "bool", "default": false }
      ],
      "affordances": []
    },
    {
      "id": "agent",
      "name": "Agent",
      "fields": [
        { "name": "policy", "type": "string", "default": "player" },
        { "name": "character", "type": "string", "default": "" },
        { "name": "goals", "type": "string", "default": "" },
        { "name": "traits", "type": "string", "default": "" },
        { "name": "memoryLength", "type": "int", "default": 25 },
        { "name": "posture", "type": "string", "default": "standing" },
        { "name": "alwaysLit", "type": "bool", "default": false },
        { "name": "activity", "type": "string", "default": "" },
        { "name": "speakingSoon", "type": "bool", "default": false },
        { "name": "voice", "type": "string", "default": "" },
        { "name": "properNames", "type": "list", "default": [] },
        { "name": "incognito", "type": "string", "default": "" },
        { "name": "incognitoDescription", "type": "string", "default": "" }
      ],
      "affordances": [
        { "verb": "look", "handler": "look", "repeatBackoff": true },
        { "verb": "inventory", "handler": "inventory" },
        { "verb": "wait", "handler": "wait", "repeatBackoff": true }
      ]
    },
    {
      "id": "can_speak",
      "name": "Can speak",
      "fields": [],
      "affordances": [
        {
          "verb": "say",
          "handler": "say",
          "speech": true,
          "prompt": "Say what?",
          "signals": [
            { "sense": "audible", "priority": 10, "audience": "onlyTarget", "text": "{agent} says to you: \"{arg}\"" },
            { "sense": "audible", "priority": 10, "text": "{agent} says: \"{arg}\"" },
            { "sense": "visual", "priority": 1, "text": "{agent}'s lips move." }
          ]
        }
      ]
    },
    {
      "id": "portal",
      "name": "Portal (door side)",
      "fields": [
        { "name": "stateRef", "type": "ref", "default": null },
        { "name": "direction", "type": "string", "default": "" },
        { "name": "to", "type": "ref", "default": null },
        { "name": "transmitVisual", "type": "string", "default": "whenOpen" },
        { "name": "transmitAudio", "type": "string", "default": "always" },
        { "name": "requires", "type": "ref", "default": null },
        { "name": "requiresCarrying", "type": "list", "default": [] },
        { "name": "notCarrying", "type": "list", "default": [] },
        { "name": "allowOnly", "type": "list", "default": [] },
        { "name": "allowPlus", "type": "int", "default": 0 },
        { "name": "loadUnder", "type": "int", "default": 0 },
        { "name": "blockedText", "type": "string", "default": "" },
        { "name": "barred", "type": "bool", "default": false },
        { "name": "barredText", "type": "string", "default": "" },
        { "name": "onExit", "type": "list", "default": [] }
      ],
      "affordances": [
        {
          "verb": "go",
          "handler": "go",
          "postures": ["standing"],
          "when": [
            { "module": "immobile", "absent": true, "on": "actor", "field": "value" }
          ],
          "gates": [
            { "kind": "exit" }
          ],
          "signals": [
            { "sense": "visual", "priority": 10, "scope": "departure", "text": "{agent} exits through the {exitPortal} to the {exitDirection}." },
            { "sense": "audible", "priority": 5, "scope": "departure", "text": "You hear {agent} leave through the {exitPortal}." },
            { "sense": "visual", "priority": 10, "scope": "arrival", "text": "{agent} enters from the {entryPortal} to the {entryDirection}." },
            { "sense": "audible", "priority": 5, "scope": "arrival", "text": "You hear footsteps approaching from the {entryPortal}." }
          ]
        }
      ]
    },
    {
      "id": "door",
      "name": "Door (openable portal side)",
      "fields": [],
      "affordances": [
        {
          "verb": "open",
          "handler": "open",
          "duration": 2,
          "gates": [{ "kind": "barred" }],
          "signals": [
            { "sense": "visual", "priority": 10, "text": "{agent} opens the {target}." },
            { "sense": "audible", "priority": 5, "text": "the sound of a door opening." }
          ]
        },
        {
          "verb": "close",
          "handler": "close",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 10, "text": "{agent} closes the {target}." },
            { "sense": "audible", "priority": 5, "text": "a door thudding shut." }
          ]
        }
      ]
    },
    {
      "id": "doorstate",
      "name": "Shared door state",
      "fields": [
        { "name": "open", "type": "bool", "default": false },
        { "name": "locked", "type": "bool", "default": false }
      ],
      "affordances": []
    },
    {
      "id": "openable",
      "name": "Openable",
      "fields": [
        { "name": "open", "type": "bool", "default": false }
      ],
      "affordances": [
        { "verb": "open", "handler": "open" },
        { "verb": "close", "handler": "close" }
      ]
    },
    {
      "id": "container",
      "name": "Container",
      "fields": [
        { "name": "capacity", "type": "int", "default": 10 }
      ],
      "affordances": [
        { "verb": "put", "handler": "put", "duration": 2 }
      ]
    },
    {
      "id": "portable",
      "name": "Portable",
      "fields": [
        { "name": "weight", "type": "int", "default": 5 }
      ],
      "affordances": [
        {
          "verb": "take",
          "handler": "take",
          "gates": [
            {
              "kind": "loadUnder",
              "args": { "max": 100, "includeTarget": true },
              "failText": "Your load is too heavy."
            }
          ],
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} picks up the {target}{container}." }
          ]
        },
        { "verb": "drop", "handler": "drop" }
      ]
    },
    {
      "id": "surface",
      "name": "Surface",
      "fields": [
        { "name": "capacity", "type": "int", "default": 10 }
      ],
      "affordances": []
    },
    {
      "id": "puttable",
      "name": "Puttable (a surface that accepts things)",
      "fields": [],
      "affordances": [
        {
          "verb": "put",
          "handler": "put",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} puts the {item} onto the {target}." }
          ]
        }
      ]
    },
    {
      "id": "lockable",
      "name": "Lockable",
      "fields": [
        { "name": "keyRef", "type": "ref", "default": null }
      ],
      "affordances": [
        { "verb": "unlock", "handler": "unlock" },
        { "verb": "lock", "handler": "lock" }
      ]
    },
    {
      "id": "hideable",
      "name": "Hideable",
      "fields": [
        { "name": "concealed", "type": "bool", "default": false }
      ],
      "affordances": []
    },
    {
      "id": "readable",
      "name": "Readable",
      "fields": [
        { "name": "text", "type": "string", "default": "" }
      ],
      "affordances": [
        { "verb": "read", "handler": "read" }
      ]
    },
    {
      "id": "lightsource",
      "name": "Light source",
      "fields": [
        { "name": "on", "type": "bool", "default": false },
        { "name": "fuel", "type": "int", "default": -1 },
        { "name": "dead", "type": "bool", "default": false },
        { "name": "outText", "type": "string", "default": "" },
        { "name": "burnStages", "type": "list", "default": [] }
      ],
      "affordances": [
        {
          "verb": "turn on",
          "handler": "set",
          "when": [
            { "module": "lightsource", "field": "on", "equals": false },
            { "module": "lightsource", "field": "dead", "equals": false }
          ],
          "data": { "module": "lightsource", "field": "on", "value": "true", "self": "You turn on {target}." }
        },
        {
          "verb": "turn off",
          "handler": "set",
          "when": [
            { "module": "lightsource", "field": "on", "equals": true }
          ],
          "data": { "module": "lightsource", "field": "on", "value": "false", "self": "You turn off {target}." }
        }
      ]
    },
    {
      "id": "treasure",
      "name": "Treasure",
      "fields": [
        { "name": "value", "type": "int", "default": 0 },
        { "name": "tvalue", "type": "int", "default": 0 },
        { "name": "scored", "type": "bool", "default": false }
      ],
      "affordances": []
    },
    {
      "id": "scorecard",
      "name": "Scorecard",
      "fields": [
        { "name": "score", "type": "int", "default": 0 },
        { "name": "deaths", "type": "int", "default": 0 },
        { "name": "caseRef", "type": "ref", "default": null }
      ],
      "affordances": [
        { "verb": "score", "handler": "score", "repeatBackoff": true }
      ]
    },
    {
      "id": "rules",
      "name": "Rules",
      "fields": [
        { "name": "diceCount", "type": "int", "default": 1 },
        { "name": "diceSides", "type": "int", "default": 20 },
        { "name": "npcLodFactor", "type": "int", "default": 10 },
        { "name": "winScore", "type": "int", "default": 0 },
        { "name": "won", "type": "bool", "default": false },
        { "name": "winText", "type": "string", "default": "" },
        { "name": "strengthFromScore", "type": "int", "default": 0 },
        { "name": "ranks", "type": "list", "default": [] },
        { "name": "darkHazardChance", "type": "int", "default": 0 },
        { "name": "darkHazardText", "type": "string", "default": "" },
        { "name": "darkHazardCondition", "type": "ref", "default": null },
        { "name": "darkArrivalText", "type": "string", "default": "You have moved into a dark place." },
        { "name": "darkText", "type": "string", "default": "" }
      ],
      "affordances": []
    },
    {
      "id": "immobile",
      "name": "Immobile",
      "fields": [],
      "affordances": []
    },
    {
      "id": "weapon",
      "name": "Weapon",
      "fields": [
        { "name": "edge", "type": "int", "default": 0 }
      ],
      "affordances": []
    },
    {
      "id": "duelist",
      "name": "Duelist (wound-level combat)",
      "fields": [
        { "name": "strength", "type": "int", "default": 2 },
        { "name": "weakTo", "type": "list", "default": [] },
        { "name": "wakeIn", "type": "int", "default": -1 },
        { "name": "out", "type": "bool", "default": false }
      ],
      "affordances": []
    },
    {
      "id": "attackable",
      "name": "Attackable (blow)",
      "fields": [],
      "affordances": [
        {
          "verb": "attack",
          "handler": "blow",
          "duration": 2,
          "postures": ["standing"],
          "when": [
            { "module": "duelist", "field": "out", "equals": false }
          ],
          "data": {
            "unconsciousCondition": "cond_unconscious",
            "deadCondition": "cond_dead"
          }
        }
      ]
    },
    {
      "id": "drinkable",
      "name": "Drinkable",
      "fields": [
        { "name": "destroyOnConsume", "type": "bool", "default": true }
      ],
      "affordances": [
        { "verb": "drink", "handler": "consume", "data": { "self": "You drink {target}. I was rather thirsty." } }
      ]
    },
    {
      "id": "flag",
      "name": "Flag (named world state)",
      "fields": [
        { "name": "value", "type": "bool", "default": false }
      ],
      "affordances": []
    },
    {
      "id": "shiftable",
      "name": "Shiftable scenery (move-verb effects)",
      "fields": [
        { "name": "onMove", "type": "list", "default": [] },
        { "name": "once", "type": "bool", "default": false },
        { "name": "moved", "type": "bool", "default": false }
      ],
      "affordances": [
        {
          "verb": "move",
          "handler": "effect",
          "when": [
            { "module": "shiftable", "field": "moved", "equals": false }
          ],
          "data": { "effectsField": "onMove", "self": "You move {target}." }
        }
      ]
    },
    {
      "id": "sense",
      "name": "Sense (proximity glow)",
      "fields": [
        { "name": "senses", "type": "list", "default": [] },
        { "name": "ignoresConditions", "type": "list", "default": [] },
        { "name": "glow", "type": "int", "default": 0 },
        { "name": "onFaint", "type": "string", "default": "" },
        { "name": "onBright", "type": "string", "default": "" },
        { "name": "onDim", "type": "string", "default": "" }
      ],
      "affordances": []
    },
    {
      "id": "automation",
      "name": "Automation rule",
      "fields": [
        { "name": "when", "type": "list", "default": [] },
        { "name": "effects", "type": "list", "default": [] },
        { "name": "once", "type": "bool", "default": false },
        { "name": "every", "type": "int", "default": 0 },
        { "name": "delay", "type": "int", "default": 0 },
        { "name": "armed", "type": "bool", "default": true }
      ],
      "affordances": []
    }
  ]
}
