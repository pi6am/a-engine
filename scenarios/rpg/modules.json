{
  "name": "rpg-modules",
  "modules": [
    {
      "id": "rules",
      "name": "Rules",
      "fields": [
        { "name": "diceCount", "type": "int", "default": 1 },
        { "name": "diceSides", "type": "int", "default": 20 }
      ],
      "affordances": []
    },
    {
      "id": "stats",
      "name": "Stats",
      "fields": [
        { "name": "values", "type": "map", "default": {} }
      ],
      "affordances": []
    },
    {
      "id": "skills",
      "name": "Skills",
      "fields": [
        { "name": "values", "type": "map", "default": {} }
      ],
      "affordances": []
    },
    {
      "id": "health",
      "name": "Health",
      "fields": [
        { "name": "maxHp", "type": "int", "default": 10 },
        { "name": "hp", "type": "int", "default": 10 },
        { "name": "incapacitatedAt", "type": "int", "default": 0 }
      ],
      "affordances": []
    },
    {
      "id": "body",
      "name": "Body",
      "fields": [
        { "name": "regions", "type": "list", "default": ["head", "top", "bottom", "feet", "hand", "held"] }
      ],
      "affordances": []
    },
    {
      "id": "wearable",
      "name": "Wearable",
      "fields": [
        { "name": "regions", "type": "list", "default": [] },
        { "name": "worn", "type": "bool", "default": false }
      ],
      "affordances": [
        {
          "verb": "wear",
          "handler": "wear",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} puts on the {target}." }
          ]
        },
        {
          "verb": "remove",
          "handler": "remove",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} takes off the {target}." }
          ],
          "failSignals": [
            { "sense": "visual", "priority": 10, "text": "{agent} grabs at the {target}!" }
          ]
        }
      ]
    },
    {
      "id": "weapon",
      "name": "Weapon",
      "fields": [
        { "name": "damageBonus", "type": "int", "default": 0 },
        { "name": "damageDice", "type": "int", "default": 1 },
        { "name": "damageSides", "type": "int", "default": 4 },
        { "name": "skill", "type": "string", "default": "" },
        { "name": "stat", "type": "string", "default": "" }
      ],
      "affordances": []
    },
    {
      "id": "armor",
      "name": "Armor",
      "fields": [
        { "name": "protection", "type": "int", "default": 1 }
      ],
      "affordances": []
    },
    {
      "id": "combatant",
      "name": "Combatant",
      "fields": [
        { "name": "attackStat", "type": "string", "default": "strength" },
        { "name": "attackSkill", "type": "string", "default": "brawling" },
        { "name": "defenseStat", "type": "string", "default": "agility" },
        { "name": "defenseSkill", "type": "string", "default": "" },
        { "name": "damageBonus", "type": "int", "default": 0 },
        { "name": "damageDice", "type": "int", "default": 1 },
        { "name": "damageSides", "type": "int", "default": 2 }
      ],
      "affordances": []
    },
    {
      "id": "attackable",
      "name": "Attackable",
      "fields": [],
      "affordances": [
        {
          "verb": "attack",
          "handler": "attack",
          "duration": 3,
          "postures": ["standing"],
          "signals": [
            { "sense": "visual", "priority": 10, "text": "{agent} hits the {target}!" },
            { "sense": "audible", "priority": 5, "text": "the crack of a blow landing." }
          ],
          "failSignals": [
            { "sense": "visual", "priority": 10, "text": "{agent} swings at the {target} and misses." }
          ]
        }
      ]
    },
    {
      "id": "room",
      "name": "Room",
      "fields": [],
      "affordances": []
    },
    {
      "id": "agent",
      "name": "Agent",
      "fields": [
        { "name": "policy", "type": "string", "default": "player" },
        { "name": "character", "type": "string", "default": "" },
        { "name": "goals", "type": "string", "default": "" },
        { "name": "memoryLength", "type": "int", "default": 25 },
        { "name": "posture", "type": "string", "default": "standing" }
      ],
      "affordances": [
        { "verb": "look", "handler": "look", "repeatBackoff": true },
        { "verb": "inventory", "handler": "inventory" },
        { "verb": "wait", "handler": "wait", "repeatBackoff": true },
        {
          "verb": "stand",
          "handler": "stand",
          "duration": 2,
          "postures": ["prone"],
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} gets up." }
          ]
        }
      ]
    },
    {
      "id": "can_speak",
      "name": "Can speak",
      "fields": [],
      "affordances": [
        {
          "verb": "say",
          "handler": "say",
          "prompt": "Say what?",
          "signals": [
            { "sense": "audible", "priority": 10, "text": "{agent} says: \"{arg}\"" },
            { "sense": "visual", "priority": 1, "text": "{agent}'s lips move." }
          ]
        }
      ]
    },
    {
      "id": "portal",
      "name": "Portal (door side)",
      "fields": [
        { "name": "stateRef", "type": "ref", "default": null },
        { "name": "direction", "type": "string", "default": "" },
        { "name": "to", "type": "ref", "default": null },
        { "name": "transmitVisual", "type": "string", "default": "whenOpen" },
        { "name": "transmitAudio", "type": "string", "default": "always" }
      ],
      "affordances": [
        {
          "verb": "go",
          "handler": "go",
          "duration": 3,
          "postures": ["standing"],
          "signals": [
            { "sense": "visual", "priority": 10, "scope": "departure", "text": "{agent} exits through the {exitPortal} to the {exitDirection}." },
            { "sense": "audible", "priority": 5, "scope": "departure", "text": "{agent} leaving through the {exitPortal}." },
            { "sense": "visual", "priority": 10, "scope": "arrival", "text": "{agent} enters from the {entryPortal} to the {entryDirection}." },
            { "sense": "audible", "priority": 5, "scope": "arrival", "text": "footsteps approaching from the {entryPortal}." }
          ]
        }
      ]
    },
    {
      "id": "doorstate",
      "name": "Shared door state",
      "fields": [
        { "name": "open", "type": "bool", "default": false },
        { "name": "locked", "type": "bool", "default": false }
      ],
      "affordances": []
    },
    {
      "id": "openable",
      "name": "Openable",
      "fields": [
        { "name": "open", "type": "bool", "default": false },
        { "name": "locked", "type": "bool", "default": false }
      ],
      "affordances": [
        {
          "verb": "open",
          "handler": "open",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 10, "text": "{agent} opens the {target}." },
            { "sense": "audible", "priority": 5, "text": "something creaking open." }
          ]
        },
        {
          "verb": "close",
          "handler": "close",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 10, "text": "{agent} closes the {target}." },
            { "sense": "audible", "priority": 5, "text": "something thudding shut." }
          ]
        }
      ]
    },
    {
      "id": "container",
      "name": "Container",
      "fields": [
        { "name": "capacity", "type": "int", "default": 10 }
      ],
      "affordances": []
    },
    {
      "id": "shoveable",
      "name": "Shoveable",
      "fields": [],
      "affordances": [
        {
          "verb": "shove",
          "handler": "shove",
          "duration": 3,
          "check": { "stat": "strength", "opposed": { "stat": "agility" } },
          "signals": [
            { "sense": "visual", "priority": 10, "text": "{agent} shoves the {target} to the ground." },
            { "sense": "audible", "priority": 5, "text": "a body hitting the ground." }
          ],
          "failSignals": [
            { "sense": "visual", "priority": 10, "text": "{agent} tries to shove the {target}, who holds their ground." }
          ]
        }
      ]
    },
    {
      "id": "portable",
      "name": "Portable",
      "fields": [],
      "affordances": [
        {
          "verb": "take",
          "handler": "take",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} picks up the {target}." }
          ]
        },
        {
          "verb": "drop",
          "handler": "drop",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} drops the {target}." },
            { "sense": "audible", "priority": 3, "text": "something hitting the floor." }
          ]
        },
        {
          "verb": "steal",
          "handler": "steal",
          "duration": 3,
          "check": { "stat": "agility", "skill": "pickpocket", "opposed": { "stat": "perception" } },
          "signals": [
            { "sense": "visual", "priority": 2, "text": "{agent} lifts the {target}." }
          ],
          "failSignals": [
            { "sense": "visual", "priority": 10, "text": "{agent} makes a grab for the {target}!" }
          ]
        }
      ]
    },
    {
      "id": "grappleable",
      "name": "Grappleable",
      "fields": [],
      "affordances": [
        {
          "verb": "grapple",
          "handler": "grapple",
          "duration": 3,
          "postures": ["standing"],
          "check": { "stat": "strength", "skill": "brawling", "opposed": { "stat": "agility" } },
          "signals": [
            { "sense": "visual", "priority": 10, "text": "{agent} seizes the {target}!" }
          ],
          "failSignals": [
            { "sense": "visual", "priority": 10, "text": "{agent} grabs at the {target}, who slips free." }
          ]
        },
        {
          "verb": "release",
          "handler": "release",
          "duration": 1,
          "signals": [
            { "sense": "visual", "priority": 5, "text": "{agent} releases the {target}." }
          ]
        }
      ]
    },
    {
      "id": "grappler",
      "name": "Grappler",
      "fields": [],
      "affordances": [
        {
          "verb": "escape",
          "handler": "escape",
          "duration": 3,
          "signals": [
            { "sense": "visual", "priority": 10, "text": "{agent} breaks free!" }
          ],
          "failSignals": [
            { "sense": "visual", "priority": 10, "text": "{agent} struggles." }
          ]
        }
      ]
    },
    {
      "id": "chokeable",
      "name": "Chokeable",
      "fields": [],
      "affordances": [
        {
          "verb": "choke",
          "handler": "choke",
          "duration": 3,
          "signals": [
            { "sense": "visual", "priority": 10, "text": "{agent} chokes the {target}!" },
            { "sense": "audible", "priority": 5, "text": "choking sounds." }
          ]
        }
      ]
    },
    {
      "id": "lockable",
      "name": "Lockable",
      "fields": [
        { "name": "keyRef", "type": "ref", "default": null }
      ],
      "affordances": [
        {
          "verb": "unlock",
          "handler": "unlock",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 3, "text": "{agent} unlocks the {target}." },
            { "sense": "audible", "priority": 5, "text": "a click." }
          ]
        },
        {
          "verb": "lock",
          "handler": "lock",
          "duration": 2,
          "signals": [
            { "sense": "visual", "priority": 3, "text": "{agent} locks the {target}." },
            { "sense": "audible", "priority": 5, "text": "a click." }
          ]
        },
        {
          "verb": "pick",
          "handler": "pick",
          "duration": 5,
          "check": { "skill": "lockpicking", "stat": "agility", "difficulty": 20 },
          "signals": [
            { "sense": "visual", "priority": 3, "text": "{agent} picks the lock on the {target}." },
            { "sense": "audible", "priority": 5, "text": "a click." }
          ]
        }
      ]
    }
  ]
}
